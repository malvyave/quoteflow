  },
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2",
    "twenty": ">=2.46.0"
  },
  "keywords": [
    "twenty-app",
    "twenty",
    "crm",
    "quotes",
    "quoting",
    "cpq"
