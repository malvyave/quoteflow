{
  "name": "twenty-quoteflow",
  "version": "0.2.0",
  "description": "QuoteFlowin for Twenty: itemized quotes on your deals. Send a link, the client accepts, the deal is won.",
  "license": "MIT",
  "author": "malvyave",
  "homepage": "https://github.com/malvyave/quoteflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malvyave/quoteflow.git"
  },
  "bugs": {
