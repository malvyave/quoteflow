    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.46.0",
    "twenty-sdk": "2.46.0",
    "twenty-ui": "2.46.0",
